# Copy to .env and fill in. Never commit real keys.
# The LLM reads the operator notes. Set at least one provider key for full accuracy.
# With no key the service still starts and answers, using the deterministic fallback parser.

# Primary provider: Groq. Use one key, or several (comma-separated, or GROQ_API_KEY_1, GROQ_API_KEY_2, ...).
# Extra keys rotate automatically when one is rate limited.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Backup provider: OpenRouter. Same rules for multiple keys (OPENROUTER_API_KEY_1, ...).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=8080
